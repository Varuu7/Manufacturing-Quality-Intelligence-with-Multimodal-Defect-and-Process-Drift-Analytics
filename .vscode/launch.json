{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🏭 Run Both (Backend + Frontend)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_all.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🚀 Run FastAPI Backend (:8000)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_backend.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "📊 Run Streamlit Frontend (:8501)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_frontend.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🧪 Run Pytest Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/",
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
